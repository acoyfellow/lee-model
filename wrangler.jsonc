{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lee-model",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "lee-model-oauth-local" }],
  "durable_objects": { "bindings": [{ "name": "LeeAgent", "class_name": "LeeAgent" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LeeAgent"] }],
  "vars": { "BRAIN_MODEL": "@cf/zai-org/glm-5.3" }
}
