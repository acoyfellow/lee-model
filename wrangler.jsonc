{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lee-model",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "bfcb6ac5b3ceaf42a09607f6f7925823",
  "workers_dev": false,
  "routes": [{ "pattern": "lee.coey.dev/*", "zone_name": "coey.dev" }],
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "424a3d42270641de9b5e65d7ea7f1897" }],
  "durable_objects": { "bindings": [{ "name": "LeeAgent", "class_name": "LeeAgent" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LeeAgent"] }],
  "vars": { "BRAIN_MODEL": "@cf/zai-org/glm-5.3" }
}
